{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "monthly-history-trend",
  "position": {
    "x": 32,
    "y": 568,
    "z": 8,
    "width": 1200,
    "height": 432,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "lineChart",
    "drillFilterOtherVisuals": true,
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "YearMonth"
                }
              },
              "queryRef": "Date.YearMonth",
              "nativeQueryRef": "YearMonth",
              "displayName": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Publication"
                    }
                  },
                  "Property": "Selected Month Publications"
                }
              },
              "queryRef": "Publication.Selected Month Publications",
              "nativeQueryRef": "Selected Month Publications",
              "displayName": "Publications"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly publication trend (Last 24 complete months)'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "15D"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "valueAxis": [
        {
          "properties": {
            "logAxisScale": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
}
