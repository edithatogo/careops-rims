table FundingDeliveryLedger
	description: "Current-user delivery revision ledger. Persistence does not prove an actual email or calendar delivery."
	lineageTag: 00000000-0000-4000-8000-f6e2a1598682

	column DeliveryEventKey
		dataType: string
		lineageTag: 00000000-0000-4000-8000-de5be9134bce
		summarizeBy: none
		sourceColumn: DeliveryEventKey

	column UserKey
		dataType: string
		lineageTag: 00000000-0000-4000-8000-914f6f5b5497
		summarizeBy: none
		sourceColumn: UserKey

	column OpportunityKey
		dataType: string
		lineageTag: 00000000-0000-4000-8000-e2b7d8ed3706
		summarizeBy: none
		sourceColumn: OpportunityKey

	column EventType
		dataType: string
		lineageTag: 00000000-0000-4000-8000-55b8405de7b0
		summarizeBy: none
		sourceColumn: EventType

	column Revision
		dataType: string
		lineageTag: 00000000-0000-4000-8000-a2d950b4a747
		summarizeBy: none
		sourceColumn: Revision

	column OffsetDays
		dataType: int64
		lineageTag: 00000000-0000-4000-8000-71d34242b257
		summarizeBy: none
		sourceColumn: OffsetDays

	column Channel
		dataType: string
		lineageTag: 00000000-0000-4000-8000-b6861d7224c1
