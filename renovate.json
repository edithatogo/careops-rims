{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>edithatogo/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Review exact source CI candidates before promotion",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "description": "Qualify Python3.15 patch candidates within the selected runtime line",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "enabled": true,
      "allowedVersions": "/^3\\.15(?:\\.|$)/"
    }
  ],
  "ignoreUnstable": false
}
