// Published-in-month, not first-observed-in-month. Check API limits and reconcile independent keys.
EVALUATE
VAR AfterKey = "" // Set to last accepted CanonicalKey; escape embedded quotes by doubling them.
VAR PageSize = 100 // Reduce on response-size errors; never advance after an error.
VAR MonthStart = MAX(ReportingWindow[ReportMonthStart])
VAR MonthEnd = MAX(ReportingWindow[ReportMonthEndExclusive])
RETURN
SELECTCOLUMNS(
    TOPN(PageSize, FILTER(
        Publication,
        Publication[CanonicalKey] > AfterKey &&
        Publication[PublicationDatePrecision] IN {"day", "month"}
            && NOT ISBLANK(Publication[PublicationDate])
            && Publication[PublicationDate] >= MonthStart
            && Publication[PublicationDate] < MonthEnd
    ), Publication[CanonicalKey], ASC),
        "CanonicalKey", Publication[CanonicalKey]
)
ORDER BY [CanonicalKey]
