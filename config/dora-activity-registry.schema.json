{
  "schema_version": "dora-activity-v1",
  "list_name": "DORA Activity Registry",
  "description": "Source-preserving Queensland Open Data DoRA research-activity register; separate from the publication registry.",
  "identity": "DORAActivityKey (resource ID + source _id)",
  "source": "https://www.data.qld.gov.au/dataset/database-of-research-activity-dora",
  "fields": [
    {"name": "DORAActivityKey", "type": "text", "required": true, "indexed": true, "unique": true},
    {"name": "DORARecordID", "type": "number", "required": true, "indexed": true},
    {"name": "DORAResourceID", "type": "text", "required": true, "indexed": true},
    {"name": "DORAResourceName", "type": "text", "required": true},
    {"name": "DORAResourceLastModified", "type": "text", "required": false},
    {"name": "DORAObservedUTC", "type": "datetime", "required": true},
    {"name": "DORASourceURL", "type": "url", "required": true},
    {"name": "Project ID", "type": "text", "required": false, "description": "Source field; not assumed unique."},
    {"name": "Review Reference", "type": "text", "required": false},
    {"name": "HREC (Ethics) Reference Number", "type": "text", "required": false},
    {"name": "Full Project Title", "type": "multiline", "required": false},
    {"name": "Short Project Title", "type": "text", "required": false},
    {"name": "Project Description", "type": "multiline", "required": false},
    {"name": "Clinical Trial (Yes/No)", "type": "text", "required": false},
    {"name": "PI Name", "type": "text", "required": false},
    {"name": "PI Email", "type": "text", "required": false},
    {"name": "Contact Person Name", "type": "text", "required": false},
    {"name": "Contact Person Email", "type": "text", "required": false},
    {"name": "Site Name", "type": "text", "required": false},
    {"name": "Sponsor Name", "type": "text", "required": false},
    {"name": "Start Date", "type": "text", "required": false},
    {"name": "Finish Date", "type": "text", "required": false},
    {"name": "Disease Category", "type": "text", "required": false},
    {"name": "Multi/Single site", "type": "text", "required": false},
    {"name": "DORA Authority (Yes/No)", "type": "text", "required": false},
    {"name": "DORA Consent (Yes/No)", "type": "text", "required": false}
  ]
}
