			summarizeBy: none
			sourceColumn: AttributionEvidence

		column PublicationDate
			dataType: dateTime
			summarizeBy: none
			sourceColumn: PublicationDate

		column PublicationDateRaw
			dataType: string
			summarizeBy: none
			sourceColumn: PublicationDateRaw

		column PublicationDatePrecision
			dataType: string
			summarizeBy: none
			sourceColumn: PublicationDatePrecision

		column PublicationYear
			dataType: int64
			summarizeBy: none
			sourceColumn: PublicationYear

		column NormalizedTitle
			dataType: string
			summarizeBy: none
			sourceColumn: NormalizedTitle

		column PMID
			dataType: string
			summarizeBy: none
			sourceColumn: PMID

		column DOI
			dataType: string
			summarizeBy: none
			sourceColumn: DOI

		column Journal
			dataType: string
			summarizeBy: none
			sourceColumn: Journal

		column CoverageStatus
