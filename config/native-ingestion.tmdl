		column Title
			dataType: string
			summarizeBy: none
			sourceColumn: Title

		column Authors
			dataType: string
			summarizeBy: none
			sourceColumn: Authors

		column Abstract
			dataType: string
			summarizeBy: none
			sourceColumn: Abstract

		column CHHHSAffiliatedAuthors
			dataType: string
			summarizeBy: none
			sourceColumn: CHHHSAffiliatedAuthors

		column AttributionEvidence
