			summarizeBy: none
			sourceColumn: CoverageStatus

		column CollectionExpectedCount
			dataType: int64
			summarizeBy: none
			sourceColumn: CollectionExpectedCount

		partition DoraPublications = m
			mode: import
			source =
				Table.SelectColumns(DoraHistoricalMetadata,{"DORAKey","DORAURL","Title","Authors","Abstract","CHHHSAffiliatedAuthors","AttributionEvidence","PublicationDate","PublicationDateRaw","PublicationDatePrecision","PublicationYear","NormalizedTitle","PMID","DOI","Journal","CoverageStatus","CollectionExpectedCount"})
