// Full scope. Check API limits and reconcile independent keys before accepting any export.
EVALUATE
VAR AfterKey = "" // Set to last accepted CanonicalKey; escape embedded quotes by doubling them.
VAR PageSize = 100 // Reduce on response-size errors; never advance after an error.
RETURN
SELECTCOLUMNS(
    TOPN(PageSize, FILTER(Publication, Publication[CanonicalKey] > AfterKey), Publication[CanonicalKey], ASC),
        "CanonicalKey", Publication[CanonicalKey],
        "Title", Publication[Title],
        "Authors", Publication[Authors],
        "Journal", Publication[Journal],
        "PublicationDateRaw", Publication[PublicationDateRaw],
        "PublicationDatePrecision", Publication[PublicationDatePrecision],
        "PublicationYear", Publication[PublicationYear],
        "PublicationMonth", Publication[PublicationMonth],
        "CHHHSAffiliatedAuthors", Publication[CHHHSAffiliatedAuthors],
        "AttributionStatus", Publication[AttributionStatus],
        "AttributionEvidence", Publication[AttributionEvidence],
        "DedupMethod", Publication[DedupMethod],
        "SourceSet", Publication[SourceSet],
        "PMID", Publication[PMID],
        "DOI", Publication[DOI],
        "PubMedURL", Publication[PubMedURL],
        "DORAURL", Publication[DORAURL],
        "MatchedFacilities", Publication[MatchedFacilities]
)
ORDER BY [CanonicalKey]
